# groq | lmstudio | ollama | auto  (auto = groq if GROQ_API_KEY is set, else lmstudio)
LLM_PROVIDER=lmstudio

# LM Studio (Developer tab -> Start Server)
LMSTUDIO_URL=http://localhost:1234/v1
# Exact model id from LM Studio; leave empty to use the loaded model
LMSTUDIO_MODEL=

# Groq cloud (optional)
GROQ_API_KEY=

# Ollama (optional)
OLLAMA_MODEL=llama3.2
