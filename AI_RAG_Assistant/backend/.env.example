# gemini | groq | lmstudio | ollama | auto  (auto = first of: Gemini key, Groq key, else LM Studio)
LLM_PROVIDER=gemini

# Google Gemini (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Exact model id as listed in AI Studio
GEMINI_MODEL=gemini-3.1-flash-lite

# LM Studio (Developer tab -> Start Server)
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=

# Groq cloud (optional)
GROQ_API_KEY=

# Ollama (optional)
OLLAMA_MODEL=llama3.2
